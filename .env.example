# OpenCanary Correlator configuration.
#
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and must
# never contain committed secrets. Real deployments should inject the same
# variables from the environment (Docker secrets, Kubernetes Secret, systemd
# EnvironmentFile) instead of shipping a file.
#
# Every variable uses the `OCC_` prefix and is read by
# `opencanary_correlator.config.Settings` (see docs/internal/EXECPLAN-refactor.md).

# --- Event intake (must stay compatible with opencanaryd) -------------------
# TCP JSON receiver: newline-delimited JSON produced by SocketJSONHandler.
OCC_TCP_ENABLED=true
OCC_TCP_HOST=0.0.0.0
OCC_TCP_PORT=1514

# Syslog receiver (RFC 3164/5424; JSON body is parsed as a canary event,
# plain-text body becomes a synthetic LOG_BASE_MSG event).
OCC_SYSLOG_ENABLED=false
OCC_SYSLOG_HOST=0.0.0.0
OCC_SYSLOG_PORT=5514
OCC_SYSLOG_UDP_ENABLED=false

# --- Hardening --------------------------------------------------------------
# Maximum size of a single JSON line. The legacy Twisted receiver used 16 KiB.
OCC_MAX_LINE_BYTES=65536
# Seconds a partially received line may stall before the peer is disconnected.
# Idle keep-alive connections are never reaped by this timeout.
OCC_PARTIAL_LINE_TIMEOUT=30
OCC_MAX_CONNECTIONS=1000
# Comma-separated IPv4/IPv6 addresses or CIDRs allowed to send events to the
# receivers, e.g. 10.0.0.0/8,192.0.2.7. Empty accepts every peer. Invalid
# entries stop the correlator at startup.
OCC_RECEIVER_ALLOWED_IPS=
OCC_EVENT_QUEUE_SIZE=10000
# Consumer lanes per receiver. Events are sharded by source host: different
# hosts are correlated in parallel, one host keeps arrival order, and one slow
# host cannot stall the rest. Each event costs several Redis round trips, so
# this is the main throughput knob for a remote or high-latency Redis.
OCC_EVENT_CONCURRENCY=8
OCC_RATE_LIMIT_EVENTS_PER_MINUTE=600

# --- State (required) -------------------------------------------------------
# All correlation state is kept here so replicas stay stateless. This must be
# one logical Redis server (primary/replica or failover endpoint is fine) with
# scripting enabled. Redis Cluster is not supported because one script updates
# an incident hash, the `incidents` index and the host pointer, and those keys
# hash to different slots (CROSSSLOT).
OCC_REDIS_URL=redis://localhost:6379/0
# Password for the bundled Redis service in docker-compose.yml. Required there
# (compose refuses to start without it); it is embedded in the correlator's
# OCC_REDIS_URL automatically. Use letters, digits, `-` and `_` only. Native
# deployments put the password in OCC_REDIS_URL instead, e.g. redis://:pass@host:6379/0.
# OCC_REDIS_PASSWORD=change-me

# --- Correlation ------------------------------------------------------------
OCC_INCIDENT_HORIZON=60
# Per-incident overrides of OCC_INCIDENT_HORIZON, as a JSON object keyed by
# canonical incident name, e.g. {"ftp.login_attempt": 300, "ssh.login_attempt": 120}
OCC_INCIDENT_HORIZONS={}
OCC_SCAN_HOST_THRESHOLD=5
OCC_SCAN_HOST_HORIZON=50
OCC_SCAN_NETWORK_THRESHOLD=2
OCC_SCAN_NETWORK_HORIZON=3600
OCC_DEDUP_TTL=60
# Newest incidents inspected in the first pass of the fallback lookup, used when
# a source host has no `incident-latest` pointer (a first-seen host, an incident
# written by an older replica, or a pointer deleted by an operator). A miss in
# that pass triggers one uncapped read of the horizon window before a new
# incident is created, so a live incident behind the cap is still merged. The
# re-read costs O(index) and runs only when no pointer and no match exist.
# 1..10000.
OCC_INCIDENT_LOOKUP_SCAN_LIMIT=100
# Timestamps and log entries stored per incident. The legacy console renders at
# most 100, so the default keeps exactly what is displayed while bounding the
# hash; events_count and events_skipped always stay exact. Raise it (1..10000)
# only if you read incidents from Redis directly.
OCC_MAX_STORED_EVENTS=100

# --- Dispatchers ------------------------------------------------------------
# Generic SIEM webhook (Elastic, Wazuh, Splunk HEC, ...); comma separated URLs.
OCC_WEBHOOK_URLS=
# Set to false to keep legacy Slack webhooks configured but suppressed.
OCC_SLACK_ENABLED=true
OCC_SLACK_WEBHOOKS=
OCC_TELEGRAM_TOKEN=
OCC_TELEGRAM_CHAT_IDS=
OCC_DISCORD_WEBHOOKS=
# Set to false to keep a legacy SMTP relay configured but suppressed.
OCC_SMTP_ENABLED=true
OCC_SMTP_HOST=
OCC_SMTP_PORT=587
OCC_SMTP_USERNAME=
OCC_SMTP_PASSWORD=
OCC_SMTP_FROM=notifications@opencanary.invalid
OCC_SMTP_TO=
OCC_SMTP_STARTTLS=true
# Implicit TLS (usually port 465). Mutually exclusive with STARTTLS; when true,
# set OCC_SMTP_STARTTLS=false.
OCC_SMTP_USE_TLS=false
# Seconds a single dispatcher delivery may take before it is abandoned.
OCC_DISPATCH_TIMEOUT=10

# --- Observability ----------------------------------------------------------
OCC_LOG_LEVEL=INFO
# `/healthz`, `/readyz` and `/metrics` listener. Set to 0 (or run with
# `--health-port 0`) to disable it; the container HEALTHCHECK follows this value.
OCC_HEALTH_PORT=8080
# Interface the listener binds to. 0.0.0.0 is reachable from other pods and from
# the Docker bridge, but the endpoint has no authentication and leaks incident
# and delivery counters. Use 127.0.0.1 (or ::1) to keep it on loopback and probe
# it locally or through a sidecar; the HEALTHCHECK follows this value too.
# `docker compose` passes this through and defaults it to 0.0.0.0 when unset.
OCC_HEALTH_HOST=0.0.0.0
# Comma-separated IPv4/IPv6 addresses or CIDRs allowed to read `/healthz`,
# `/readyz` and `/metrics`. Defaults to loopback; an empty value also means
# loopback, so the endpoint is never open to every peer by accident. Requests
# from other peers receive 403. Invalid entries stop the correlator at startup.
OCC_HEALTH_ALLOWED_IPS=127.0.0.1/32,::1/128
