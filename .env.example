# OpenCanary Correlator configuration.
#
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and must
# never contain committed secrets. Real deployments should inject the same
# variables from the environment (Docker secrets, Kubernetes Secret, systemd
# EnvironmentFile) instead of shipping a file.
#
# Every variable uses the `OCC_` prefix and is read by
# `opencanary_correlator.config.Settings` (see docs/internal/EXECPLAN-refactor.md).

# --- Event intake (must stay compatible with opencanaryd) -------------------
# Interface the receivers bind to. Loopback is the default because the canary
# usually runs on this same host: an intake port open on every interface is an
# unauthenticated write path into the incident store. Set 0.0.0.0 only when
# canaries on other machines must reach it.
# Note: `docker compose` forces 0.0.0.0 inside the container (the published port
# is forwarded to the bridge address) and narrows the public binding instead —
# see OCC_TCP_PUBLISH_HOST below.
# TCP JSON receiver: newline-delimited JSON produced by SocketJSONHandler.
OCC_TCP_ENABLED=true
OCC_TCP_HOST=127.0.0.1
# Deliberately uncommon: a honeypot imitates 21/22/80/443/8080, so the
# correlator listens where the traps do not.
OCC_TCP_PORT=15140

# Syslog receiver (RFC 3164/5424; JSON body is parsed as a canary event,
# plain-text body becomes a synthetic LOG_BASE_MSG event).
OCC_SYSLOG_ENABLED=false
OCC_SYSLOG_HOST=127.0.0.1
OCC_SYSLOG_PORT=15141
OCC_SYSLOG_UDP_ENABLED=false

# --- Published port bindings (docker compose only) --------------------------
# Address the compose port mapping listens on. 127.0.0.1 keeps the intake
# unreachable from the network while the canary stays on this host; set
# 0.0.0.0 (and OCC_TCP_HOST/OCC_SYSLOG_HOST=0.0.0.0) for remote canaries. These
# live here, not in docker-compose.yml, so an update cannot widen them again.
OCC_TCP_PUBLISH_HOST=127.0.0.1
OCC_SYSLOG_PUBLISH_HOST=127.0.0.1

# --- Hardening --------------------------------------------------------------
# Maximum size of a single JSON line. The legacy Twisted receiver used 16 KiB.
OCC_MAX_LINE_BYTES=65536
# Seconds a partially received line may stall before the peer is disconnected.
# Idle keep-alive connections are never reaped by this timeout.
OCC_PARTIAL_LINE_TIMEOUT=30
OCC_MAX_CONNECTIONS=1000
# Comma-separated IPv4/IPv6 addresses or CIDRs allowed to send events to the
# receivers, e.g. 10.0.0.0/8,192.0.2.7. Empty accepts every peer. Invalid
# entries stop the correlator at startup.
OCC_RECEIVER_ALLOWED_IPS=
OCC_EVENT_QUEUE_SIZE=10000
# Consumer lanes per receiver. Events are sharded by source host: different
# hosts are correlated in parallel, one host keeps arrival order, and one slow
# host cannot stall the rest. Each event costs several Redis round trips, so
# this is the main throughput knob for a remote or high-latency Redis.
OCC_EVENT_CONCURRENCY=8
OCC_RATE_LIMIT_EVENTS_PER_MINUTE=600

# --- State (required) -------------------------------------------------------
# All correlation state is kept here so replicas stay stateless. This must be
# one logical Redis server (primary/replica or failover endpoint is fine) with
# scripting enabled. Redis Cluster is not supported because one script updates
# an incident hash, the `incidents` index and the host pointer, and those keys
# hash to different slots (CROSSSLOT).
OCC_REDIS_URL=redis://localhost:6379/0
# Password for the bundled Redis service in docker-compose.yml. Required there
# (compose refuses to start without it); it is embedded in the correlator's
# OCC_REDIS_URL automatically. Use letters, digits, `-` and `_` only. Native
# deployments put the password in OCC_REDIS_URL instead, e.g. redis://:pass@host:6379/0.
# OCC_REDIS_PASSWORD=change-me

# --- Correlation ------------------------------------------------------------
OCC_INCIDENT_HORIZON=60
# Per-incident overrides of OCC_INCIDENT_HORIZON, as a JSON object keyed by
# canonical incident name, e.g. {"ftp.login_attempt": 300, "ssh.login_attempt": 120}
OCC_INCIDENT_HORIZONS={}
OCC_SCAN_HOST_THRESHOLD=5
OCC_SCAN_HOST_HORIZON=50
OCC_SCAN_NETWORK_THRESHOLD=2
OCC_SCAN_NETWORK_HORIZON=3600
# Window in which an identical event is suppressed. 0 disables deduplication.
OCC_DEDUP_TTL=60
# How long the claim is held before the event is correlated. It must stay far
# below OCC_DEDUP_TTL: a claim taken for the whole window would be unreleasable
# by a process that dies mid-correlation, and the canary's redelivery after the
# restart would be swallowed as a duplicate.
OCC_DEDUP_LEASE=10
# Newest incidents inspected in the first pass of the fallback lookup, used when
# a source host has no `incident-latest` pointer (a first-seen host, an incident
# written by an older replica, or a pointer deleted by an operator). A miss in
# that pass triggers one uncapped read of the horizon window before a new
# incident is created, so a live incident behind the cap is still merged. The
# re-read costs O(index) and runs only when no pointer and no match exist.
# 1..10000.
OCC_INCIDENT_LOOKUP_SCAN_LIMIT=100
# Timestamps and log entries stored per incident. The legacy console renders at
# most 100, so the default keeps exactly what is displayed while bounding the
# hash; events_count and events_skipped always stay exact. Raise it (1..10000)
# only if you read incidents from Redis directly.
OCC_MAX_STORED_EVENTS=100
# Samba audit actions that must not create an incident, comma separated, matched
# against the AUDITACTION field of the event (`connect`, `openat`, `flistxattr`,
# `create_file`, ...). Empty by default: an upgrade never changes which events
# are correlated. A share that a single client browses produces a row per
# directory operation, so `flistxattr` (a listing, not an access) is the usual
# value here. Every suppressed event is counted as `opencanary_events_ignored_total`
# and audited as `event_ignored` with `reason=smb_action`, so the suppression is
# never indistinguishable from a lost event.
OCC_SMB_IGNORE_ACTIONS=

# --- Dispatchers ------------------------------------------------------------
# Generic SIEM webhook (Elastic, Wazuh, Splunk HEC, ...); comma separated URLs.
OCC_WEBHOOK_URLS=
# Slack is off until both lines are filled: enabling it without a webhook is a
# startup error, and a webhook with the switch off logs a warning at startup.
# (A legacy `slack_notification_enable` key is imported into OCC_SLACK_ENABLED.)
OCC_SLACK_ENABLED=false
OCC_SLACK_WEBHOOKS=
OCC_TELEGRAM_TOKEN=
OCC_TELEGRAM_CHAT_IDS=
OCC_DISCORD_WEBHOOKS=
# Set to false to keep a legacy SMTP relay configured but suppressed.
OCC_SMTP_ENABLED=true
OCC_SMTP_HOST=
OCC_SMTP_PORT=587
OCC_SMTP_USERNAME=
OCC_SMTP_PASSWORD=
OCC_SMTP_FROM=notifications@opencanary.invalid
OCC_SMTP_TO=
OCC_SMTP_STARTTLS=true
# Implicit TLS (usually port 465). Mutually exclusive with STARTTLS; when true,
# set OCC_SMTP_STARTTLS=false.
OCC_SMTP_USE_TLS=false
# Seconds a single dispatcher delivery may take before it is abandoned.
OCC_DISPATCH_TIMEOUT=10

# --- Alert outbox -----------------------------------------------------------
# A new incident and one pending delivery per channel are written in one Redis
# script, and a worker retries whatever a channel did not accept (backoff 1 s,
# 5 s, 30 s, 5 min, 30 min). Delivery is therefore at-least-once: a duplicate is
# possible only when a channel accepted a message and the process died before
# recording it. `OCC_OUTBOX_ENABLED=false` restores the old best-effort
# behaviour, where a failed delivery is logged and forgotten.
OCC_OUTBOX_ENABLED=true
# Seconds between retry passes, and how long one worker owns an entry before
# another replica may take it (a worker that dies mid-delivery loses nothing).
OCC_OUTBOX_POLL_INTERVAL=5
OCC_OUTBOX_LEASE=60
# Deliveries handled per pass.
OCC_OUTBOX_BATCH=20
# Attempts before an entry moves to the `outbox:dead` list for inspection.
OCC_OUTBOX_MAX_ATTEMPTS=8
# Retention of the delivered marker and of a pending entry, in seconds.
OCC_OUTBOX_DELIVERY_RETENTION=604800

# --- Alert budget -----------------------------------------------------------
# A burst of distinct incidents (one subnet probing a hundred addresses) can bury
# the alert an operator needed to see. The budget rations *notifications*, not
# incidents: every incident is still stored and visible in the console, only the
# message is withheld. Each refusal is audited as `alert_suppressed`, and the
# window's refusals are delivered as one summary when the window closes
# (`alert_summary`), so the ration cannot hide itself. Counters live in Redis, so
# replicas behind a load balancer share one budget.
# Off by default: silently withholding an alert is a decision the operator makes
# for their own traffic, not a default.
OCC_ALERT_BUDGET_ENABLED=false
# Notifications per canary and across all canaries inside one window.
OCC_ALERT_BUDGET_PER_NODE=20
OCC_ALERT_BUDGET_GLOBAL=200
# Window length in seconds, and how often a worker looks for closed windows.
OCC_ALERT_BUDGET_WINDOW=3600
OCC_ALERT_BUDGET_POLL_INTERVAL=60

# --- Alert detail -----------------------------------------------------------
# How much of an incident each channel puts in the message. Three levels:
#   minimal  - the legacy single line, unchanged from the old correlator
#   standard - instance (name, IP), attacker (IP, source port), time, one log entry
#   detailed - standard plus destination address, event count and up to 3 log entries
# Lines are separated with CRLF; chat channels use their native markdown.
# Credential-looking log fields (PASSWORD, SECRET, TOKEN, ...) are always masked.
# Every channel a person reads (Telegram, Slack, Discord, SMTP) defaults to
# `standard`. The webhook stays on `minimal` because a SIEM parser may depend on
# its `text` field: it receives the attacker context as a separate `enrichment`
# JSON object at every level, so nothing has to be raised for geo data.
OCC_TELEGRAM_DETAIL=standard
OCC_SLACK_DETAIL=standard
OCC_DISCORD_DETAIL=standard
OCC_WEBHOOK_DETAIL=minimal
OCC_SMTP_DETAIL=standard
# SMB incidents (`Shared File Opened`) are rendered from the Samba audit record
# rather than a `KEY=value` dump: user, share, path and the audit action with its
# status, plus the client fingerprint and domain at the `detailed` level. The
# fields come from OpenCanary itself, so nothing is configured on the honeypot.

# --- Service messages (off by default) --------------------------------------
# The correlator talking about itself through the channels above: a rejected
# VirusTotal key, an exhausted quota, a GeoIP database that stopped answering, a
# channel whose circuit breaker opened, no channel delivering at all, and the
# process starting or stopping. Each (kind, subject) speaks once per cooldown and
# the message says how often it repeated meanwhile, so one broken dependency
# cannot replace the alerts it is supposed to accompany.
# Empty OCC_SERVICE_CHANNELS means every enabled channel.
OCC_SERVICE_ENABLED=false
# OCC_SERVICE_CHANNELS=telegram,slack
# Groups to allow: enrichment, channels, ingestion, canary, lifecycle.
OCC_SERVICE_CATEGORIES=enrichment,channels
# Seconds before the same (kind, subject) can speak again.
OCC_SERVICE_COOLDOWN=3600
# info, warning or critical: anything quieter is dropped. `lifecycle` messages
# are `info`, so enabling that category here requires `info` - the combination is
# rejected at startup instead of silently producing nothing.
OCC_SERVICE_MIN_SEVERITY=warning

# --- Daily digest (off by default) ------------------------------------------
# One message a day with what the correlator did: events in, incidents, alerts
# out, drops by reason, VirusTotal quota spent and the busiest attacker
# addresses. The window is the trailing 24 hours, not midnight to midnight, so a
# run is never partial. Replicas elect one sender and mark the day, so scaling out
# does not multiply the message.
OCC_DIGEST_ENABLED=false
# UTC HH:MM. A malformed value is a startup error, not a silently ignored one.
OCC_DIGEST_TIME=03:00
# Empty means OCC_SERVICE_CHANNELS.
# OCC_DIGEST_CHANNELS=telegram
# Attacker addresses listed under "busiest sources"; 0 disables the section.
OCC_DIGEST_TOP_SOURCES=5

# --- Ingestion reports (off by default) -------------------------------------
# Events the correlator dropped in one OCC_WATCH_INTERVAL before it says so, and
# payloads that failed validation in the same window. A single malformed payload
# belongs in the audit trail; a rate above these is a sender, a full queue or a
# dispatch path that stopped working. 0 disables that kind. Both need
# OCC_SERVICE_ENABLED=true and `ingestion` in OCC_SERVICE_CATEGORIES; the
# combinations that would report nothing are refused at startup.
OCC_SERVICE_DROPS_THRESHOLD=0
OCC_SERVICE_REJECTIONS_THRESHOLD=0

# --- Silent canaries (off by default) ---------------------------------------
# A node that used to deliver and then stopped is the one failure with no event
# attached to it: the correlator remembers when each node last delivered and
# compares that with this threshold, once per OCC_WATCH_INTERVAL. 0 disables it.
# Needs OCC_SERVICE_ENABLED=true and `canary` in OCC_SERVICE_CATEGORIES; the
# combinations that would report nothing are refused at startup instead of
# looking enabled.
OCC_CANARY_SILENT_AFTER=0
# Seconds between window checks. The last-seen memory is process-local and
# travels to the other replicas inside the heartbeat the digest already writes,
# so no Redis write happens per event.
OCC_WATCH_INTERVAL=300

# --- Attacker enrichment (off by default) -----------------------------------
# Country, city and ASN are read from local MMDB files, so no attacker address
# leaves the host. Get DB-IP Lite (free, monthly, CC BY 4.0) from
# https://db-ip.com/db/lite.php and mount the files into the container:
#   dbip-city-lite-YYYY-MM.mmdb  -> OCC_GEOIP_CITY_DB
#   dbip-asn-lite-YYYY-MM.mmdb   -> OCC_GEOIP_ASN_DB (optional)
# A configured path that cannot be opened stops startup instead of silently
# enriching nothing. Needs the `geo` extra: pip install 'opencanary-correlator[geo]'.
# OCC_GEOIP_CITY_DB=/data/geoip/dbip-city-lite.mmdb
# OCC_GEOIP_ASN_DB=/data/geoip/dbip-asn-lite.mmdb
# VirusTotal reputation. Setting the key is the consent to send attacker
# addresses to virustotal.com; leave it blank to disable the lookup entirely.
# The free public API allows 4 lookups/min, 500/day and 15.5K/month; the client
# reserves a slot in all three windows before spending a request and answers from
# a per-address cache otherwise. An exhausted window renders as
# `VT: quota exhausted` in the alert instead of a silent gap.
OCC_VIRUSTOTAL_API_KEY=
OCC_VIRUSTOTAL_PER_MINUTE=4
OCC_VIRUSTOTAL_PER_DAY=500
OCC_VIRUSTOTAL_PER_MONTH=15500
# Seconds a verdict is reused for the same address (default 7 days).
OCC_VIRUSTOTAL_CACHE_TTL=604800
OCC_VIRUSTOTAL_TIMEOUT=5
# Budget for one enrichment pass. Keep it below OCC_DISPATCH_TIMEOUT so a slow
# lookup cannot delay the alert.
OCC_ENRICHMENT_TIMEOUT=6

# --- Observability ----------------------------------------------------------
# Operational log level: DEBUG, INFO, WARNING, ERROR or CRITICAL (case-insensitive,
# WARN/FATAL accepted). INFO reports every failed delivery and rejected event;
# DEBUG adds per-event correlation detail. The JSON audit trail on stdout is
# unaffected by this setting.
OCC_LOG_LEVEL=INFO
# Optional log file. Unset or empty means "stderr only". A path adds a
# size-rotated UTF-8 file (10 MiB x 5 backups: correlator.log, correlator.log.1,
# ...) and creates its directory when missing; stderr keeps receiving the same
# lines. An unopenable path stops the correlator with exit 2.
# Left commented out on purpose: `docker compose` then supplies the path of the
# mounted `correlator-logs` volume. Set it to an empty value to opt out there.
# OCC_LOG_FILE=/var/log/opencanary-correlator/logs/correlator.log
# `/healthz`, `/readyz` and `/metrics` listener. 15142 avoids 8080, which
# honeypot modules imitate as an alternative HTTP port. Set to 0 (or run with
# `--health-port 0`) to disable it; the container HEALTHCHECK follows this value.
OCC_HEALTH_PORT=15142
# Interface the listener binds to. 0.0.0.0 is reachable from other pods and from
# the Docker bridge, but the endpoint has no authentication and leaks incident
# and delivery counters. Use 127.0.0.1 (or ::1) to keep it on loopback and probe
# it locally or through a sidecar; the HEALTHCHECK follows this value too.
# `docker compose` passes this through and defaults it to 0.0.0.0 when unset.
OCC_HEALTH_HOST=0.0.0.0
# Comma-separated IPv4/IPv6 addresses or CIDRs allowed to read `/healthz`,
# `/readyz` and `/metrics`. Defaults to loopback; an empty value also means
# loopback, so the endpoint is never open to every peer by accident. Requests
# from other peers receive 403. Invalid entries stop the correlator at startup.
OCC_HEALTH_ALLOWED_IPS=127.0.0.1/32,::1/128
