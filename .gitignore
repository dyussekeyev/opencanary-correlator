# https://github.com/github/gitignore/blob/master/Python.gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Geo databases (DB-IP/GeoLite2) are user data, mounted by docker-compose
geoip/

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Local development environment
.venv/
.env
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Secrets and local configuration (only the template is versioned)
.env.*
!.env.example
*.pem
*.key
secrets/

# Local data and database dumps
*.rdb
*.aof
*.sqlite
*.sqlite3

# Test and tool caches
.hypothesis/

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Freebuff Desktop project marker (local chat index, never commit)
.freebuff/

# Internal planning documents (ExecPlans), not published
docs/internal/
